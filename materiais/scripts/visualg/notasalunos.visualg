algoritmo "notasalunos"
var
  n1, n2, x: real
inicio
  escreval("Nota 1: ")
  leia(n1)
  escreval("Nota 2: ")
  leia(n2)
  x <- (n1 + n2) / 2
  escreval("A média do aluno foi ", x)
  se (x >= 7) entao
    escreval("Aluno APROVADO")
  senao
    se (x >= 5) e (x < 7) entao
      escreval("Aluno de RECUPERAÇÃO")
    senao
      escreval("Aluno REPROVADO")
    fimse
  fimse
fimalgoritmo